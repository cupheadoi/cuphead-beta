# Backend runtime. Run the API only on a service with a persistent disk (VPS,
# Render disk, Railway volume, etc.). Vercel hosts the static frontend only.
NODE_ENV=development
PORT=3000

# Required in production. Use a 32+ character random secret.
SESSION_SECRET=

# Browser origin(s) allowed to call this API, and the URL baked into the Vercel frontend.
APP_ORIGIN=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Must be outside the source checkout in production.
DATABASE_PATH=/var/lib/cuphead/cuphead.sqlite
UPLOADS_PATH=/var/lib/cuphead/uploads

# One-time owner bootstrap. Remove these values after the initial owner exists.
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_FIRST_NAME=
BOOTSTRAP_OWNER_LAST_NAME=
BOOTSTRAP_OWNER_GRADE=
