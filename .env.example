# Environment variables
# Port is locked to 3000 by AI Studio container runtime
SESSION_SECRET=

# Optional custom path to store SQLite database permanently (e.g. outside git repo on VPS / server)
DATABASE_PATH=

# Vercel Blob persistence token (automatically provided when you create a Blob store in Vercel)
# Enables zero-loss persistent SQLite across Vercel redeploys
BLOB_READ_WRITE_TOKEN=
