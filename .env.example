# Environment variables
# Optional locally; hosting platforms normally assign this automatically
PORT=3000

# Required in production. Use a stable random value with at least 32 characters.
SESSION_SECRET=

# Optional custom path to store SQLite database permanently (e.g. outside git repo on VPS / server)
DATABASE_PATH=

# Required on Vercel. Connect a PRIVATE Vercel Blob store to create this token.
BLOB_READ_WRITE_TOKEN=
